# Local `uvicorn main:app --reload` only.
# docker-compose.yml sets its own values and ignores this file.

AI_BASE_URL=http://localhost:9000
AI_TIMEOUT_SECONDS=120

# Opt in to the vision-first upload milestone. Install requirements-ai.txt first.
# docker-compose.yml still runs the legacy OCR-only demo and ignores this file.
IMAGE_PROCESSING_MODE=document
DOCUMENT_CACHE_DIR=data/documents
DOCUMENT_TIMEOUT_SECONDS=600
MAX_IMAGE_PIXELS=40000000
SIGNSPEAK_LLM_URL=http://127.0.0.1:8091

DB_PATH=data/app.db
MEDIA_DIR=data/media

CORS_ORIGINS=*
MAX_UPLOAD_MB=15
TTS_VOICE=en-US-AvaNeural

# Off until the AI service has /v1/tts (scans return text only).
TTS_ENABLED=false
