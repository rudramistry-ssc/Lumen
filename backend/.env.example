# Local `uvicorn main:app --reload` only.
# docker-compose.yml sets its own values and ignores this file.

AI_BASE_URL=http://localhost:9000
AI_TIMEOUT_SECONDS=120

DB_PATH=data/app.db
MEDIA_DIR=data/media

CORS_ORIGINS=*
MAX_UPLOAD_MB=15
TTS_VOICE=en-US-AvaNeural

# Make audio for each scan and reply through the AI service's /v1/tts.
# false = text only (faster). run.py turns it on when a speech engine exists.
TTS_ENABLED=true
